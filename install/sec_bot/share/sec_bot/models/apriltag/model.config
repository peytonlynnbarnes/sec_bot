<?xml version="1.0"?>
<model>
  <name>Simple Sign</name>
  <version>1.0</version>
  <sdf version="1.7">model.sdf</sdf>
  
  <author>
    <name>User</name>
    <email>user@example.com</email>
  </author>
  
  <description>
    A simple rectangular sign with a neutral surface, designed for custom texture application.
    Dimensions: 50cm wide, 30cm tall, 2cm thick with a thin frame.
  </description>
  
  <depend>
    <model>ground_plane</model>
  </depend>
  
  <tags>
    <tag>sign</tag>
    <tag>display</tag>
    <tag>static</tag>
  </tags>
</model>
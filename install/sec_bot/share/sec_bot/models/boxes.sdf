<?xml version="1.0" ?>
<sdf version="1.7">
  <model name="simple_cube">
    <static>false</static>  <!-- Set to false to allow movement -->
    <link name="link">
      <inertial>
        <!-- Mass in kg (assuming medium density material) -->
        <mass>1.0</mass>
        <!-- Inertia values for a cube -->
        <inertia>
          <ixx>0.0041</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.0041</iyy>
          <iyz>0</iyz>
          <izz>0.0041</izz>
        </inertia>
      </inertial>
      <collision name="collision">
        <geometry>
          <box>
            <size>0.1524 0.1524 0.1524</size>  <!-- 6in × 6in × 6in in meters -->
          </box>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>0.8</mu>
              <mu2>0.8</mu2>
            </ode>
          </friction>
          <contact>
            <ode>
              <max_vel>0.1</max_vel>
              <min_depth>0.001</min_depth>
            </ode>
          </contact>
        </surface>
      </collision>
      <visual name="visual">
        <geometry>
          <box>
            <size>0.1524 0.1524 0.1524</size>  <!-- 6in × 6in × 6in in meters -->
          </box>
        </geometry>
        <material>
          <ambient>0.3 0.3 0.8 1</ambient>
          <diffuse>0.3 0.3 0.8 1</diffuse>
          <specular>0.1 0.1 0.1 1</specular>
        </material>
      </visual>
    </link>
  </model>
</sdf>
<?xml version="1.0" ?>
<sdf version="1.7">
  <world name="default">
    <!-- Add a sun for better lighting -->
    <include>
      <uri>model://sun</uri>
    </include>
    
    <!-- Ground plane representing the field surface -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>2.4384 1.2192</size> <!-- 96in x 48in -->
            </plane>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>1</mu>
                <mu2>1</mu2>
              </ode>
            </friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>2.4384 1.2192</size> <!-- 96in x 48in -->
            </plane>
          </geometry>
          <material>
            <ambient>0.7 0.7 0.7 1</ambient>
            <diffuse>0.7 0.7 0.7 1</diffuse>
            <specular>0.01 0.01 0.01 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- Field enclosure (walls) -->
    <model name="field_enclosure">
      <static>true</static>
      <pose>0 0 0.05 0 0 0</pose> <!-- Slight elevation to avoid z-fighting -->
      <link name="walls">
        <!-- North Wall (along y-axis, positive side) -->
        <collision name="north_wall_collision">
          <pose>0 0.6096 0 0 0 0</pose> <!-- 48in/2 = 24in = 0.6096m -->
          <geometry>
            <box>
              <size>2.4384 0.0381 0.1016</size> <!-- 96in x 1.5in x 4in -->
            </box>
          </geometry>
        </collision>
        <visual name="north_wall_visual">
          <pose>0 0.6096 0 0 0 0</pose>
          <geometry>
            <box>
              <size>2.4384 0.0381 0.1016</size>
            </box>
          </geometry>
          <material>
            <ambient>0.5 0.5 0.5 1</ambient>
            <diffuse>0.5 0.5 0.5 1</diffuse>
          </material>
        </visual>

        <!-- South Wall (along y-axis, negative side) -->
        <collision name="south_wall_collision">
          <pose>0 -0.6096 0 0 0 0</pose>
          <geometry>
            <box>
              <size>2.4384 0.0381 0.1016</size> <!-- 96in x 1.5in x 4in -->
            </box>
          </geometry>
        </collision>
        <visual name="south_wall_visual">
          <pose>0 -0.6096 0 0 0 0</pose>
          <geometry>
            <box>
              <size>2.4384 0.0381 0.1016</size>
            </box>
          </geometry>
          <material>
            <ambient>0.5 0.5 0.5 1</ambient>
            <diffuse>0.5 0.5 0.5 1</diffuse>
          </material>
        </visual>

        <!-- East Wall (along x-axis, positive side) -->
        <collision name="east_wall_collision">
          <pose>1.2192 0 0 0 0 0</pose> <!-- 96in/2 = 48in = 1.2192m -->
          <geometry>
            <box>
              <size>0.0381 1.2192 0.1016</size> <!-- 1.5in x 48in x 4in -->
            </box>
          </geometry>
        </collision>
        <visual name="east_wall_visual">
          <pose>1.2192 0 0 0 0 0</pose>
          <geometry>
            <box>
              <size>0.0381 1.2192 0.1016</size>
            </box>
          </geometry>
          <material>
            <ambient>0.5 0.5 0.5 1</ambient>
            <diffuse>0.5 0.5 0.5 1</diffuse>
          </material>
        </visual>

        <!-- West Wall (along x-axis, negative side) -->
        <collision name="west_wall_collision">
          <pose>-1.2192 0 0 0 0 0</pose>
          <geometry>
            <box>
              <size>0.0381 1.2192 0.1016</size> <!-- 1.5in x 48in x 4in -->
            </box>
          </geometry>
        </collision>
        <visual name="west_wall_visual">
          <pose>-1.2192 0 0 0 0 0</pose>
          <geometry>
            <box>
              <size>0.0381 1.2192 0.1016</size>
            </box>
          </geometry>
          <material>
            <ambient>0.5 0.5 0.5 1</ambient>
            <diffuse>0.5 0.5 0.5 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Box at the end of the field - constructed with individual wall segments to make it truly hollow -->
    <!-- Base position is at x = -0.7779, y = 0, z = 0.3048 -->

    <!-- Box - west wall (back wall) -->
    <model name="box_wall_west">
      <static>true</static>
      <pose>-1.2192 0 0.3048 0 0 0</pose> <!-- Back wall aligned with field wall -->
      <link name="link">
        <collision name="collision">
          <geometry>
            <box>
              <size>0.0381 1.2192 0.6096</size> <!-- 1.5in x 48in x 24in -->
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>0.0381 1.2192 0.6096</size>
            </box>
          </geometry>
          <material>
            <ambient>0.6 0.6 0.6 1</ambient>
            <diffuse>0.6 0.6 0.6 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Box - north wall -->
    <model name="box_wall_north">
      <static>true</static>
      <pose>-0.7779 0.6096 0.3048 0 0 0</pose> <!-- Aligned with field north wall -->
      <link name="link">
        <collision name="collision">
          <geometry>
            <box>
              <size>0.9144 0.0381 0.6096</size> <!-- 36in x 1.5in x 24in -->
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>0.9144 0.0381 0.6096</size>
            </box>
          </geometry>
          <material>
            <ambient>0.6 0.6 0.6 1</ambient>
            <diffuse>0.6 0.6 0.6 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Box - south wall -->
    <model name="box_wall_south">
      <static>true</static>
      <pose>-0.7779 -0.6096 0.3048 0 0 0</pose> <!-- Aligned with field south wall -->
      <link name="link">
        <collision name="collision">
          <geometry>
            <box>
              <size>0.9144 0.0381 0.6096</size> <!-- 36in x 1.5in x 24in -->
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>0.9144 0.0381 0.6096</size>
            </box>
          </geometry>
          <material>
            <ambient>0.6 0.6 0.6 1</ambient>
            <diffuse>0.6 0.6 0.6 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Box - east wall top portion (above door) -->
    <model name="box_wall_east_top">
      <static>true</static>
      <pose>-0.3429 0 0.5334 0 0 0</pose> <!-- 0.4064m (door height) + 0.1016m (gap) from bottom + 0.3048m (base) -->
      <link name="link">
        <collision name="collision">
          <geometry>
            <box>
              <size>0.0381 1.2192 0.1524</size> <!-- 1.5in x 48in x 6in remaining height -->
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>0.0381 1.2192 0.1524</size>
            </box>
          </geometry>
          <material>
            <ambient>0.6 0.6 0.6 1</ambient>
            <diffuse>0.6 0.6 0.6 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Box - east wall left portion (left of door) -->
    <model name="box_wall_east_left">
      <static>true</static>
      <pose>-0.3429 0.4064 0.3048 0 0 0</pose> <!-- 16in (0.4064m) + door width offset -->
      <link name="link">
        <collision name="collision">
          <geometry>
            <box>
              <size>0.0381 0.4064 0.6096</size> <!-- 1.5in x remaining width x door height -->
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>0.0381 0.4064 0.6096</size>
            </box>
          </geometry>
          <material>
            <ambient>0.6 0.6 0.6 1</ambient>
            <diffuse>0.6 0.6 0.6 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Box - east wall right portion (right of door) -->
    <model name="box_wall_east_right">
      <static>true</static>
      <pose>-0.3429 -0.4064 0.3048 0 0 0</pose> <!-- 16in (0.4064m) + door width offset -->
      <link name="link">
        <collision name="collision">
          <geometry>
            <box>
              <size>0.0381 0.4064 0.6096</size> <!-- 1.5in x remaining width x door height -->
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>0.0381 0.4064 0.6096</size>
            </box>
          </geometry>
          <material>
            <ambient>0.6 0.6 0.6 1</ambient>
            <diffuse>0.6 0.6 0.6 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Box - top/ceiling wall -->
    <model name="box_wall_top">
      <static>true</static>
      <pose>-0.7779 0 0.6096 0 0 0</pose> <!-- At the top of the box -->
      <link name="link">
        <collision name="collision">
          <geometry>
            <box>
              <size>0.9144 1.2192 0.0381</size> <!-- 36in x 48in x 1.5in -->
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>0.9144 1.2192 0.0381</size>
            </box>
          </geometry>
          <material>
            <ambient>0.6 0.6 0.6 1</ambient>
            <diffuse>0.6 0.6 0.6 1</diffuse>
          </material>
        </visual>
      </link>
    </model>
  </world>
</sdf>
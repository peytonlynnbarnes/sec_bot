<?xml version="1.0"?>
<sdf version="1.6">
  <world name="default">
    <!-- Add a standard ground plane with collisions -->
   <model name="my_ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
          <material>
            <script>
              <!-- This is just a typical Gazebo material reference -->
              <uri>file://media/materials/scripts/gazebo.material</uri>
              <name>Gazebo/White</name>
            </script>
          </material>
        </visual>
      </link>
    </model>

    <!-- Optionally, include a sun for lighting -->
    <include>
      <uri>model://sun</uri>
    </include>

    <!-- Your purple ball model remains as is (if you need it) -->
    <model name="purple_ball">
      <static>false</static>
      <link name="ball_link">
        <pose>0 0 0.5 0 0 0</pose>
        <visual name="visual">
          <geometry>
            <sphere>
              <radius>0.2</radius>
            </sphere>
          </geometry>
          <material>
            <ambient>0.5 0 0.5 1</ambient>
            <diffuse>0.5 0 0.5 1</diffuse>
          </material>
        </visual>
        <collision name="collision">
          <geometry>
            <sphere>
              <radius>0.2</radius>
            </sphere>
          </geometry>
        </collision>
      </link>
    </model>
  </world>
</sdf>
